# Backend environment for running Laravel directly (tests, artisan on the host).
# The Docker Compose stack reads ../.env instead — see ../.env.example.
APP_NAME=PrivateCloud
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=15432
DB_DATABASE=privatecloud
DB_USERNAME=privatecloud
DB_PASSWORD=privatecloud

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=strict

QUEUE_CONNECTION=database
CACHE_STORE=database

SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:8080,127.0.0.1:8080

PC_DATA_DIR=
PC_AUTO_HTTPS=off
PC_APPS_DB_HOST=127.0.0.1
PC_APPS_DB_PORT=15433
PC_APPS_DB_ADMIN_PASSWORD=
