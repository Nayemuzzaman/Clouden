# FrankenPHP configuration for the PrivateCloud API + dashboard container.
# TLS is terminated by the edge Caddy container; this listener is internal only.
{
	admin off
	auto_https off
	frankenphp
}

:8000 {
	root * /app/public
	encode zstd gzip

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	php_server
}
