# ---------------------------------------------------------------------------
# PrivateCloud configuration (read by docker compose and the control plane).
# scripts/install.sh generates this file with strong random secrets.
# Never commit the real .env file.
# ---------------------------------------------------------------------------

# Name shown in the dashboard.
PC_NAME=PrivateCloud

# Dashboard hostname. Point its DNS A record at this server before installing.
PC_DASHBOARD_DOMAIN=cloud.example.com
APP_URL=https://cloud.example.com
# Email for Let's Encrypt expiry notices (optional but recommended).
PC_ACME_EMAIL=

# Public IPv4/IPv6 of this server, used to verify domain DNS records.
PC_PUBLIC_IPV4=
PC_PUBLIC_IPV6=

# Absolute data directory on the host (backups, routing config, builds).
PC_DATA_DIR=/var/lib/privatecloud

# Laravel
APP_NAME=PrivateCloud
APP_ENV=production
APP_DEBUG=false
APP_KEY=
LOG_LEVEL=info
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=strict

# Platform database password (internal network only).
DB_PASSWORD=
# Superuser password of the PostgreSQL server for application databases.
PC_APPS_DB_ADMIN_PASSWORD=

# Container user for the control plane and the host's docker group id.
PC_UID=33
PC_GID=33
DOCKER_GID=999

# HTTPS for project domains: "on" (Let's Encrypt) or "off" (plain HTTP, development only).
PC_AUTO_HTTPS=on

# Tunables (defaults shown; see backend/config/privatecloud.php)
# PC_BUILD_TIMEOUT=1800
# PC_MIN_FREE_DISK_MB=2048
# PC_METRICS_RETENTION_DAYS=3
# PC_THRESHOLD_CPU=90
# PC_THRESHOLD_MEMORY=90
# PC_THRESHOLD_DISK=85
# PC_PASSWORD_CONFIRM_MINUTES=15
